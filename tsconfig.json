{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@chatgpt-tela/browser-host": ["packages/browser-host/src/index.ts"],
      "@chatgpt-tela/chatgpt": ["packages/chatgpt/src/index.ts"],
      "@chatgpt-tela/chat-service": ["packages/chat-service/src/index.ts"],
      "@chatgpt-tela/codex": ["packages/codex/src/index.ts"],
      "@chatgpt-tela/codex-service": ["packages/codex-service/src/index.ts"],
      "@chatgpt-tela/core": ["packages/core/src/index.ts"],
      "@chatgpt-tela/credential-store": ["packages/credential-store/src/index.ts"],
      "@chatgpt-tela/default-desktop-target": ["packages/default-desktop-target/src/index.ts"],
      "@chatgpt-tela/development-runtime": ["packages/development-runtime/src/index.ts"],
      "@chatgpt-tela/development-runtime/browser-profile": ["packages/development-runtime/src/browser-profile.ts"],
      "@chatgpt-tela/electron-host": ["packages/electron-host/src/index.ts"],
      "@chatgpt-tela/http-host": ["packages/http-host/src/index.ts"],
      "@chatgpt-tela/gateway": ["packages/gateway/src/index.ts"],
      "@chatgpt-tela/mcp": ["packages/mcp/src/index.ts"],
      "@chatgpt-tela/local-server": ["packages/local-server/src/index.ts"],
      "@chatgpt-tela/product-lifecycle": ["packages/product-lifecycle/src/index.ts"],
      "@chatgpt-tela/product-uninstall": ["packages/product-uninstall/src/index.ts"],
      "@chatgpt-tela/product-config": ["packages/product-config/src/index.ts"],
      "@chatgpt-tela/responses": ["packages/responses/src/index.ts"],
      "@chatgpt-tela/runtime": ["packages/runtime/src/index.ts"],
      "@chatgpt-tela/service-protocol": ["packages/service-protocol/src/index.ts"],
      "@chatgpt-tela/service-protocol/client": ["packages/service-protocol/src/client.ts"],
      "@chatgpt-tela/service-supervisor": ["packages/service-supervisor/src/index.ts"],
      "@chatgpt-tela/setup": ["packages/setup/src/index.ts"],
      "@chatgpt-tela/tailscale-ingress": ["packages/tailscale-ingress/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"]
}
