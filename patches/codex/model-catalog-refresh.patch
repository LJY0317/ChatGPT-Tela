+pub struct TelaModelCatalogRefreshResponse {
+    pub contract_version: u32,
+    pub catalog: TelaModelCatalogRefreshCatalog,
+}
+
+/// Wire-equivalent list envelope with a distinct schema identity, not a second catalog authority.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct TelaModelCatalogRefreshCatalog {
+    pub data: Vec<Model>,
+    pub next_cursor: Option<String>,
+}
