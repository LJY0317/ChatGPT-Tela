+#[test_case::test_case(false; "static_catalog")]
+#[test_case::test_case(true; "seeded_remote_catalog")]
+#[tokio::test]
+async fn startup_catalog_seed_preserves_remote_discovery(seed_catalog: bool) {
+    let server = MockServer::start().await;
+    let mut row = codex_models_manager::bundled_models_response()
+        .expect("bundled models")
+        .models
+        .remove(0);
+    row.slug = "fixture-seed-web".into();
+    row.visibility = codex_protocol::openai_models::ModelVisibility::List;
+    let seed = ModelsResponse {
+        models: vec![row.clone()],
+    };
+    row.slug = "fixture-updated-web".into();
+    let remote = ModelsResponse { models: vec![row] };
+    let request = mount_models_once(&server, remote.clone()).await;
+    let home = tempdir().expect("tempdir");
+    let mut config = test_config().await;
+    config.codex_home = home.path().abs();
+    config.model_provider.base_url = Some(server.uri());
+    config
+        .features
+        .set_enabled(Feature::TelaSeededModelCatalog, seed_catalog)
+        .expect("set seed feature");
+    config.model_catalog = Some(seed.clone());
+    let auth =
+        AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+    let manager = build_models_manager(&config, auth);
+    assert_eq!(manager.get_remote_models().await, seed.models);
+    let actual = manager
+        .raw_model_catalog(
+            RefreshStrategy::Online,
+            crate::test_support::default_http_client_factory(),
+        )
+        .await;
+    assert_eq!(actual, if seed_catalog { remote } else { seed });
+    assert_eq!(request.requests().len(), usize::from(seed_catalog));
+}
